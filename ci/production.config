# Production: nothing on the debug UART, nothing read from it, and no way into
# rockusb or bootrom download. Merged over either flavour's defconfig by
# ci/build.sh (FRAGMENT=production.config). Console recording stays on, so
# /chosen/u-boot,log still carries everything u-boot would have printed.
CONFIG_SILENT_CONSOLE=y
CONFIG_SILENT_CONSOLE_ALWAYS=y
CONFIG_SILENT_U_BOOT_ONLY=y
CONFIG_CONSOLE_DISABLE_CLI=y
CONFIG_BOOTDELAY=-2
CONFIG_ROCKCHIP_NO_DOWNLOAD=y
# CONFIG_CMD_ROCKUSB is not set
